# =========================================
# GITHUB RUNNER - Environment Configuration
# =========================================
# Copy to .env and FILL WITH REAL VALUES
# NEVER commit .env to Git!
# =========================================

ACCESS_TOKEN=ghp_yourPersonalAccessTokenHere
RUNNER_WORKDIR=/_work
EPHEMERAL=true
DISABLE_AUTOMATIC_DEREGISTRATION=false

REPO_URL=https://github.com/YOUR_USERNAME/YOUR_REPO
RUNNER_NAME=main-runner
LABELS=self-hosted,docker,linux